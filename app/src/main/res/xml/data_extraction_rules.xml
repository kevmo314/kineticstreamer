<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (DataStore) hold WHIP bearer tokens and stream URLs; never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
